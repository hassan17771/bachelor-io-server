{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug JLink backend memory test",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "tests.test_jlink_backend_memory",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "WCET_JLINK_HOST": "127.0.0.1",
        "WCET_JLINK_PORT": "2331",
        "WCET_JLINK_TEST_ADDR": "0x20004C00",
        "WCET_JLINK_TEST_SIZE": "16"
      },
      "justMyCode": false
    },
    {
      "name": "Debug current unittest file",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "${relativeFile}",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "WCET_JLINK_HOST": "127.0.0.1",
        "WCET_JLINK_PORT": "2331",
        "WCET_JLINK_TEST_ADDR": "0x20004C00",
        "WCET_JLINK_TEST_SIZE": "16"
      },
      "justMyCode": false
    }
  ]
}
